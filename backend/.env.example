DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/clubno1
SECRET_KEY=change-me-to-a-random-secret
ENVIRONMENT=development

# SMTP for receipt emails (POST /bills/{id}/send-email). Leave SMTP_HOST
# blank to disable sending (the endpoint returns a clear error instead of
# hanging). Provider: Gmail. SMTP_USERNAME is the full @gmail.com address;
# SMTP_PASSWORD is a 16-character App Password (myaccount.google.com/
# apppasswords — requires 2-Step Verification on the account), NOT the
# normal account password, which Gmail's SMTP rejects outright. Gmail also
# enforces From == the authenticated account (or a verified alias on it),
# so SMTP_FROM's address must match SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Club No. 1 <your-account@gmail.com>
